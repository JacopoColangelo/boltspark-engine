+typedef struct {
+	DWORD process_id;
+	HWND window;
+} owner_window_search;
+
+static BOOL CALLBACK find_owner_window(HWND candidate, LPARAM param) {
+	owner_window_search *search = (owner_window_search*)param;
+	DWORD process_id = 0;
+	wchar_t class_name[32];
+	GetWindowThreadProcessId(candidate, &process_id);
+	if( process_id != search->process_id || !IsWindowVisible(candidate) )
+		return TRUE;
+	if( GetWindow(candidate, GW_OWNER) != NULL )
+		return TRUE;
+	if( GetClassNameW(candidate, class_name, sizeof(class_name) / sizeof(wchar_t)) == 0 )
+		return TRUE;
+	if( wcscmp(class_name, USTR("HL_WIN")) != 0 )
+		return TRUE;
+	search->window = candidate;
+	return FALSE;
+}
+
+HL_PRIM bool HL_NAME(win_set_owner_process)(HWND wnd, int process_id) {
+	owner_window_search search;
+	search.process_id = (DWORD)process_id;
+	search.window = NULL;
+	EnumWindows(find_owner_window, (LPARAM)&search);
+	if( search.window == NULL )
+		return false;
+	SetLastError(0);
+	LONG_PTR previous = SetWindowLongPtr(wnd, GWLP_HWNDPARENT, (LONG_PTR)search.window);
+	return previous != 0 || GetLastError() == 0;
+}
+
+HL_PRIM bool HL_NAME(win_activate)(HWND wnd) {
+	if( IsIconic(wnd) )
+		ShowWindow(wnd, SW_RESTORE);
+	else
+		ShowWindow(wnd, SW_SHOW);
+	BringWindowToTop(wnd);
+	SetForegroundWindow(wnd);
+	SetFocus(wnd);
+	return GetForegroundWindow() == wnd;
+}
+
+HL_PRIM void HL_NAME(win_set_interactive_resize_callback)( vclosure *callback ) {
+	if( !interactive_resize_callback_rooted ) {
+		hl_add_root(&interactive_resize_callback);
+		interactive_resize_callback_rooted = true;
+	}
+	interactive_resize_callback = callback;
+}
