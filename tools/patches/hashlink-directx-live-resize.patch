+// Repaint immediately at the new size during a Win32 resize loop. Otherwise
+// Windows stretches the previous frame into the resized window, which looks
+// like the whole UI is being squashed while the border is being dragged.
+static void triggerInteractiveResizeFrame( HWND wnd, bool throttled ) {
+	dx_events *buf = get_events(wnd);
+	DWORD now = GetTickCount();
+	if( buf && buf->is_interactive_sizing && interactive_resize_callback &&
+		!interactive_resize_callback_running &&
+		(!throttled || now - buf->last_interactive_resize >= 16) ) {
+		buf->last_interactive_resize = now;
+		interactive_resize_callback_running = true;
+		bool isException = false;
+		hl_dyn_call_safe(interactive_resize_callback, NULL, 0, &isException);
+		interactive_resize_callback_running = false;
+		if( isException ) {
+			interactive_resize_callback = NULL;
+			OutputDebugStringA("Boltspark: interactive resize frame callback failed.\n");
+		}
+	}
+}
