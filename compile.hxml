# Windows 11 native editor build — HashLink + Heaps + DirectX 12 (hldx)
-cp src
-lib heaps
-lib format
-lib hldx
-D dx12
# HashLink runtime version in toolchain/hashlink. Required for Heaps' DX12 driver,
# which uses hl.CArray (HashLink 1.13+ API) that the compiler does not enable by default.
-D hl_ver=1.16.0
-D windowSize=1440x900
-debug
-hl bin/boltspark.hl
-main Main
